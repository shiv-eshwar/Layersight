#!/bin/sh
# Blocks pushing any commit that is not authored and committed solely by
# shiv-eshwar, or that carries a co-author or Cursor attribution (see github.md).

ALLOWED_NAME="shiv-eshwar"
ALLOWED_EMAILS="bl.en.u4cse23072@bl.students.amrita.edu 149902164+shiv-eshwar@users.noreply.github.com"
ZERO="0000000000000000000000000000000000000000"

remote="$1"
status=0

email_allowed() {
  case " $ALLOWED_EMAILS " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    commits="$(git rev-list "$local_sha" --not --remotes="$remote")"
  else
    commits="$(git rev-list "$remote_sha..$local_sha")"
  fi

  for c in $commits; do
    short="$(git log -1 --format=%h "$c")"
    an="$(git log -1 --format=%an "$c")"
    ae="$(git log -1 --format=%ae "$c")"
    cn="$(git log -1 --format=%cn "$c")"
    ce="$(git log -1 --format=%ce "$c")"

    if [ "$an" != "$ALLOWED_NAME" ] || ! email_allowed "$ae"; then
      echo "pre-push: $short author is '$an <$ae>'" >&2
      status=1
    fi
    if [ "$cn" != "$ALLOWED_NAME" ] || ! email_allowed "$ce"; then
      echo "pre-push: $short committer is '$cn <$ce>'" >&2
      status=1
    fi
    if git log -1 --format=%B "$c" | grep -qiE '^[[:space:]]*co-authored-by:|cursoragent|cursor agent'; then
      echo "pre-push: $short message contains a co-author or Cursor attribution" >&2
      status=1
    fi
  done
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push blocked. Fix the commits above (github.md, 'Fixing a bad commit')." >&2
fi
exit "$status"
